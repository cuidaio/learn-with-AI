# 数据库
DATABASE_URL=postgresql://learn:learn123@postgres:5432/learn

# ===== Embedding 配置（可独立选择平台） =====
# 例如：SiliconFlow / OpenAI / 智谱等
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# ===== LLM 配置（可独立选择平台） =====
# 例如：DeepSeek / OpenAI / 智谱等
LLM_BASE_URL=https://api.deepseek.com/v1/
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 分块参数（可调）
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=1500
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200

# L1/L2 语义块参数
SECTION_BLOCK_MIN_CHARS=500
SECTION_BLOCK_MAX_CHARS=3000
PARAGRAPH_BLOCK_MIN_CHARS=200
PARAGRAPH_BLOCK_MAX_CHARS=1200
PARAGRAPH_OVERLAP=100

# L1 边界检测参数
VOCABULARY_WINDOW_SIZE=3
VOCABULARY_SIMILARITY_THRESHOLD=0.3
CONTINUITY_KEYWORD_OVERLAP_THRESHOLD=0.3

# 信号融合权重（M1.3）
STRUCTURAL_WEIGHT=1.0
VOCABULARY_WEIGHT=0.6
CONTINUITY_WEIGHT=0.4
COMBINED_BOOST_THRESHOLD=0.4

# 结构信号置信度阈值（M1.3）
STRUCTURAL_HIGH_THRESHOLD=0.7
STRUCTURAL_MEDIUM_THRESHOLD=0.4
VOCABULARY_MIN_THRESHOLD=0.5

# ===== 知识图谱配置（M2.8） =====
GRAPH_EXTRACTION_BATCH_SIZE=10
GRAPH_MIN_CONFIDENCE=0.6
GRAPH_MAX_ENTITIES_PER_DOC=50
GRAPH_MAX_RELATIONS_PER_DOC=80
